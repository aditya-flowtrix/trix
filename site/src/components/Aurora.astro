---
/**
 * A slow, grainy glow behind the home page's hero, in the theme's colors:
 * the brand green rising from below on the section's own background. WebGL
 * draws it; without WebGL the CSS gradient underneath stands in, and with
 * reduced motion it draws one still frame. Decorative, so hidden from
 * assistive technology. Place it in a Section's `background` slot.
 */
---

<div class="aurora_wrap" aria-hidden="true">
  <canvas class="aurora_canvas"></canvas>
</div>

<style is:global>
  @layer components {
    .aurora_wrap {
      overflow: hidden;
      /* The still version, shown until (or instead of) the moving one. */
      background:
        radial-gradient(
          60% 45% at 50% 100%,
          color-mix(in srgb, var(--brand-300) 55%, transparent),
          transparent 70%
        ),
        var(--background);
    }
    :root:not([data-mode="dark"]) .aurora_wrap {
      background:
        radial-gradient(
          60% 45% at 50% 100%,
          color-mix(in srgb, var(--brand-200) 45%, transparent),
          transparent 70%
        ),
        var(--background);
    }
    .aurora_canvas {
      display: block;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 1.2s var(--hover-ease);

      &.is-ready {
        opacity: 1;
      }
    }
  }
</style>

<script>
  const VERTEX = `#version 300 es
  in vec2 p;
  void main() { gl_Position = vec4(p, 0.0, 1.0); }`;

  // Two soft glows wandering on a domain-warped field, then grain.
  const FRAGMENT = `#version 300 es
  precision highp float;
  uniform vec2 res;
  uniform float time;
  uniform vec3 base;
  uniform vec3 glow;
  uniform vec3 deep;
  uniform float strength;
  uniform float grain;
  out vec4 color;

  float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x),
               mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
  }
  float fbm(vec2 p) {
    float v = 0.0, a = 0.5;
    for (int i = 0; i < 4; i++) { v += a * noise(p); p *= 2.0; a *= 0.5; }
    return v;
  }

  void main() {
    vec2 uv = gl_FragCoord.xy / res;
    vec2 p = vec2((uv.x - 0.5) * res.x / res.y, uv.y);
    float t = time * 0.06;
    vec2 warp = vec2(fbm(p * 1.4 + t), fbm(p * 1.4 - t + 4.0)) - 0.5;

    // A dome rising from the bottom edge, and a second glow drifting beside it.
    vec2 a = vec2(sin(t * 1.3) * 0.35, -0.2 + 0.06 * sin(t * 0.8));
    vec2 da = (p - a + warp * 0.5) * vec2(0.8, 1.2);
    float ga = exp(-dot(da, da) * 1.5);

    vec2 b = vec2(cos(t * 0.9) * 0.55 + 0.1, -0.05 + 0.08 * cos(t * 1.2));
    vec2 db = (p - b + warp * 0.7) * vec2(1.0, 1.5);
    float gb = exp(-dot(db, db) * 3.2);

    // The top stays the page's own color, so the headline sits on calm ground.
    float lift = smoothstep(0.95, 0.1, uv.y);
    vec3 c = base;
    c = mix(c, deep, clamp(gb * strength * 0.8 * lift, 0.0, 1.0));
    c = mix(c, glow, clamp(ga * strength * lift, 0.0, 1.0));
    c += (hash(gl_FragCoord.xy) - 0.5) * grain;
    color = vec4(c, 1.0);
  }`;

  const wrap = document.querySelector<HTMLElement>(".aurora_wrap");
  const canvas = wrap?.querySelector<HTMLCanvasElement>(".aurora_canvas");
  const gl = canvas?.getContext("webgl2", { antialias: false, alpha: false });

  if (wrap && canvas && gl) {
    const shader = (type: number, source: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, source);
      gl.compileShader(s);
      return s;
    };
    const program = gl.createProgram()!;
    gl.attachShader(program, shader(gl.VERTEX_SHADER, VERTEX));
    gl.attachShader(program, shader(gl.FRAGMENT_SHADER, FRAGMENT));
    gl.linkProgram(program);
    gl.useProgram(program);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    const position = gl.getAttribLocation(program, "p");
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
    const u = (name: string) => gl.getUniformLocation(program, name);

    // The theme's own colors, read through a probe so any CSS color resolves.
    const probe = document.createElement("span");
    probe.hidden = true;
    wrap.append(probe);
    const rgb = (value: string) => {
      probe.style.color = value;
      const nums = getComputedStyle(probe)
        .color.match(/[\d.]+/g)!
        .map(Number);
      const srgb = getComputedStyle(probe).color.startsWith("color(");
      return nums.slice(0, 3).map((n) => (srgb ? n : n / 255)) as [
        number,
        number,
        number,
      ];
    };
    const paint = () => {
      const dark = document.documentElement.dataset.mode === "dark";
      gl.uniform3fv(u("base"), rgb("var(--background)"));
      gl.uniform3fv(
        u("glow"),
        rgb(dark ? "var(--brand-300)" : "var(--brand-200)"),
      );
      gl.uniform3fv(
        u("deep"),
        rgb(dark ? "var(--brand-800)" : "var(--brand-50)"),
      );
      gl.uniform1f(u("strength"), dark ? 0.85 : 0.7);
      gl.uniform1f(u("grain"), dark ? 0.07 : 0.05);
    };
    paint();
    new MutationObserver(() => {
      paint();
      play();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-mode"],
    });

    const resize = () => {
      const scale = Math.min(devicePixelRatio, 2);
      canvas.width = Math.round(canvas.clientWidth * scale);
      canvas.height = Math.round(canvas.clientHeight * scale);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(u("res"), canvas.width, canvas.height);
    };
    new ResizeObserver(resize).observe(canvas);
    resize();

    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let visible = true;
    let frame = 0;
    const start = performance.now() - 20000;
    const draw = (now: number) => {
      gl.uniform1f(u("time"), (now - start) / 1000);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      canvas.classList.add("is-ready");
      frame =
        visible && !still.matches && !document.hidden
          ? requestAnimationFrame(draw)
          : 0;
    };
    const play = () => {
      if (!frame) frame = requestAnimationFrame(draw);
    };
    // Only while it can be seen: off screen or in a background tab, it rests.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) play();
    }).observe(wrap);
    document.addEventListener("visibilitychange", play);
    still.addEventListener("change", play);
    play();
  }
</script>
