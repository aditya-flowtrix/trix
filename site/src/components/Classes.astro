---
/**
 * Every class in one of Trix's stylesheets, grouped under the file's own
 * section banners, read at build — so the list is the CSS as it is today.
 * A family that only steps through a scale (`padding-0` … `padding-12`)
 * is one row.
 */
interface Props {
  /** The stylesheet: `utilities`, `patterns`, or `generated/utilities`. */
  of: string;
  /** The level of each section's heading, to fit the page's outline. */
  level?: 2 | 3;
}

const { of, level = 3 } = Astro.props;
const Section = `h${level}` as const;
const sheets = import.meta.glob<string>("@/styles/**/*.css", {
  query: "?raw",
  import: "default",
  eager: true,
});
const css = Object.entries(sheets).find(([path]) =>
  path.endsWith(`/styles/${of}.css`),
)?.[1];
if (!css) throw new Error(`<Classes of="${of}">: no src/styles/${of}.css`);

type Row = { names: string[]; decls: string };
const sections: { title: string; rows: Row[] }[] = [];
const banner = /^\/\*\s*([^*\n]+?)\s*(?:\*\/|$)/;
const rule = /^(\.[\w-]+(?:,\s*\n?\.[\w-]+)*)\s*\{([^{}]*)\}/;
for (const block of css.split(/\n(?=\/\*|\.[\w-])/)) {
  const title = block.match(banner)?.[1];
  if (title && !/generated by|hand-written/i.test(title))
    sections.push({ title, rows: [] });
  const m = block.match(rule);
  if (!m) continue;
  if (!sections.length) sections.push({ title: "", rows: [] });
  sections.at(-1)!.rows.push({
    names: m[1].split(/,\s*/).map((s) => s.trim().slice(1)),
    decls: m[2]
      .split(";")
      .map((d) => d.trim().replace(/\s+/g, " "))
      .filter(Boolean)
      .join("; "),
  });
}

// `padding-1` … `padding-12` → one row, `padding-{1…12}`.
const step = /-(\d+|auto|none|xsmall|small|medium|large|xlarge|round)$/;
const merged = sections.map(({ title, rows }) => {
  const out: { name: string; decls: string }[] = [];
  for (let i = 0; i < rows.length;) {
    const base = rows[i].names[0].replace(step, "");
    let j = i;
    while (
      j < rows.length &&
      rows[j].names.length === 1 &&
      rows[j].names[0].replace(step, "") === base &&
      step.test(rows[j].names[0])
    )
      j++;
    if (j - i >= 3) {
      const steps = rows.slice(i, j).map((r) => r.names[0].match(step)![1]);
      out.push({
        name: `${base}-{${steps[0]}…${steps.at(-1)}}`,
        decls: rows[i].decls.replace(new RegExp(`\\b${steps[0]}\\b`), "N"),
      });
      i = j;
    } else {
      out.push({ name: rows[i].names.join(", "), decls: rows[i].decls });
      i++;
    }
  }
  return { title, rows: out };
});
---

{
  merged
    .filter((s) => s.rows.length)
    .map((s) => (
      <>
        {s.title && (
          <Section id={s.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}>
            {s.title}
          </Section>
        )}
        <div
          class="props_wrap"
          tabindex="0"
          role="region"
          aria-label={s.title || of}
        >
          <table class="props_table">
            <tbody>
              {s.rows.map((r) => (
                <tr>
                  <th scope="row">
                    <code>{r.name}</code>
                  </th>
                  <td>
                    <code class="props_type">{r.decls}</code>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ))
}
