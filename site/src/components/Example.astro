---
import { Code } from "astro:components";
import { codeThemes } from "~/code-theme.ts";

interface Props {
  /** The code shown under the example — the fence's own text. None for a specimen. */
  code?: string;
  /** How the stage lays the example out. */
  stage?: "row" | "stack" | "block" | "full" | "sections";
}

const { code, stage = "row" } = Astro.props;
---

<figure class="example_wrap">
  <div class="example_stage" data-stage={stage}><slot /></div>
  {
    code && (
      <Code code={code} lang="astro" themes={codeThemes} defaultColor={false} />
    )
  }
</figure>
