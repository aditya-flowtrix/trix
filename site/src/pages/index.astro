---
import Layout from "~/layouts/Layout.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Row from "@/components/wrapper/Row.astro";
import Col from "@/components/wrapper/Col.astro";
import Icon from "@/components/media/Icon.astro";
import Aurora from "~/components/Aurora.astro";
import WhyTrix from "~/components/WhyTrix.astro";
import { Code } from "astro:components";
import { codeThemes } from "~/code-theme.ts";
import { organization, website } from "@/utils/schema.ts";
import { CREATE_COMMAND, REPO } from "@/consts.ts";
import pkg from "../../../package.json";

const features: { icon: string; title: string; text: string; span?: number }[] =
  [
    {
      icon: "palette",
      title: "A style guide that cannot drift",
      text: "Every token on one page — type, color, themes, spacing, grid — rendered from the files the site is built from, never copied, and ready to show a client. On a migration it is measured against the old site and proven identical at every width.",
      span: 6,
    },
    {
      icon: "arrows-left-right",
      title: "Moves a site in",
      text: "Agent skills bring a Webflow, Framer, WordPress, Wix or Squarespace site across — pages, CMS collections, other languages, assets, redirects and SEO — into content collections or a headless CMS like Sanity, and check the result against the source.",
      span: 6,
    },
    {
      icon: "squares-four",
      title: "A 12-column grid",
      text: "Row and Col on the grid the designer draws on: spans, offsets and order, stacking on tablet and phone without a line of CSS.",
    },
    {
      icon: "arrows-out-line-horizontal",
      title: "Fluid by default",
      text: "Every size is two numbers, phone and desktop. Type and spacing scale smoothly between them and with the reader's font size.",
    },
    {
      icon: "figma-logo",
      title: "One token system with Figma",
      text: "Tokens export as Figma variables and import back from them, so design and code share every name and value.",
    },
    {
      icon: "stack",
      title: "Components, no libraries",
      text: "Sections, forms, tabs, sliders, filters and modals that already know how to be accessible — HTML, CSS and Trix's own scripts, with no jQuery, GSAP, Swiper or Finsweet.",
    },
    {
      icon: "rocket-launch",
      title: "Ready to launch",
      text: "Metadata and structured data on every page, a cookie banner that holds every tracker until the visitor allows it, light and dark mode, and a Content Security Policy one switch away.",
    },
    {
      icon: "check-circle",
      title: "Tested everywhere",
      text: "Every page in Chromium, Firefox and WebKit, checked against WCAG 2.2 AA every week.",
    },
  ];
---

<Layout schema={[organization(), website()]}>
  <Section
    paddingTop="large"
    paddingBottom="large"
    align="center"
    gap="6"
    class="home-hero_wrap"
  >
    <Aurora slot="background" />
    <Eyebrow variant="tag">
      <span class="text-transform-none">v{pkg.trix.version}</span>
    </Eyebrow>
    <Heading tag="h1" variant="display" maxWidth={14} class="alignment-center">
      A design-ready framework for Astro
    </Heading>
    <Paragraph variant="large" maxWidth={34} class="alignment-center">
      Accessible components, fluid tokens, a 12-column grid, and one design
      system shared between Figma and code.
    </Paragraph>
    <div class="home-install_wrap">
      <Code
        code={CREATE_COMMAND}
        lang="bash"
        themes={codeThemes}
        defaultColor={false}
      />
    </div>
    <ButtonWrapper marginTop="0">
      <Button element="link" href="/docs">Read the docs</Button>
      <Button element="link" href={REPO} emphasis="secondary">GitHub</Button>
    </ButtonWrapper>
  </Section>
  <Section paddingTop="small" paddingBottom="large">
    <Row rowGap="8" animate>
      {
        features.map((f) => (
          <Col span={f.span ?? 4}>
            <div class="home-feature_wrap">
              <Icon name={f.icon} variant="medium" />
              <Heading tag="h2" variant="h6">
                {f.title}
              </Heading>
              <Paragraph variant="small" maxWidth={60} class="color-faded">
                {f.text}
              </Paragraph>
            </div>
          </Col>
        ))
      }
    </Row>
  </Section>
  <WhyTrix />
</Layout>

<style is:global>
  @layer components {
    /* The hero fills the screen under the header, like the glow behind it. */
    .home-hero_wrap {
      min-height: calc(100svh - 3.5rem);
    }
    .home-install_wrap {
      width: min(100%, 36rem);
    }
    .home-feature_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      width: 100%;
      height: 100%;
      padding: var(--space-5);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);

      > [class] {
        margin-block: 0;
      }
    }
  }
</style>
