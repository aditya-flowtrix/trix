---
import Layout from "~/layouts/Layout.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import StyleGuide from "@/components/content/StyleGuide.astro";
---

<Layout
  title="Style Guide"
  description="Trix's default design system — type, color, themes, spacing, layout, motion and icons — rendered live from its tokens."
>
  <StyleGuide componentsHref="/docs/components/section">
    <Paragraph variant="large" maxWidth={60}>
      Trix's default tokens, rendered from <code>src/styles/tokens.css</code>
      and <code>src/styles/themes.css</code>. Every project renders its own at
      <code>/style-guide</code>, from its own brand.
      <a href="/docs/system/style-guide">How it works</a>
    </Paragraph>
  </StyleGuide>
</Layout>
