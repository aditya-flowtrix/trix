# Response headers, read by Cloudflare (Workers static assets and Pages) and
# Netlify. https://developers.cloudflare.com/workers/static-assets/headers/

# Astro fingerprints everything in /_astro/ — a changed file gets a new name —
# so browsers can keep these for a year without asking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
