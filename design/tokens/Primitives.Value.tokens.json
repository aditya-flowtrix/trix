  "font": {
    "family": {
      "primary": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "Arial",
          "sans-serif"
        ]
      },
      "secondary": {
        "$type": "fontFamily",
        "$value": "{font.family.primary}"
      }
    },
    "weight": {
      "light": {
        "$type": "fontWeight",
        "$value": 300
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "line-height": {
    "small": {
      "$type": "number",
      "$value": 100,
      "$description": "Percent of font size (Figma line height %)."
    },
    "medium": {
      "$type": "number",
      "$value": 110,
      "$description": "Percent of font size (Figma line height %)."
    },
    "large": {
      "$type": "number",
      "$value": 130,
      "$description": "Percent of font size (Figma line height %)."
    },
    "xlarge": {
      "$type": "number",
      "$value": 140,
      "$description": "Percent of font size (Figma line height %)."
    },
    "huge": {
      "$type": "number",
      "$value": 150,
      "$description": "Percent of font size (Figma line height %)."
    }
  },
  "letter-spacing": {
    "tight": {
      "$type": "number",
      "$value": -3,
      "$description": "Percent of font size (Figma letter spacing %)."
    },
    "normal": {
      "$type": "number",
      "$value": 0,
      "$description": "Percent of font size (Figma letter spacing %)."
    },
    "wide": {
      "$type": "number",
      "$value": 5,
      "$description": "Percent of font size (Figma letter spacing %)."
    },
    "wider": {
      "$type": "number",
      "$value": 10,
      "$description": "Percent of font size (Figma letter spacing %)."
    }
  },
  "radius": {
    "xsmall": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "small": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
