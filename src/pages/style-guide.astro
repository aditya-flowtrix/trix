---
import Layout from "@/layouts/BaseLayout.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import StyleGuide from "@/components/content/StyleGuide.astro";
---

<Layout
  title="Style Guide"
  description="Every token in the design system, rendered live from src/styles/tokens.css."
  gridOverlay
>
  <StyleGuide>
    <Paragraph variant="large" maxWidth={60}>
      The design system this site is built from, in one place: its brand, type,
      colors, spacing, layout, motion, icons and components. Nothing here is
      drawn by hand. Every value is read from
      <code>src/styles/tokens.css</code> and
      <code>src/styles/themes.css</code>, so change a token and this page, the
      utilities, the Figma variables and the docs follow.
    </Paragraph>
  </StyleGuide>
</Layout>
