---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";

type VideoRatio = "2-1" | "16-9" | "3-2" | "5-4" | "1-1" | "4-5" | "2-3";

type Head = Omit<
  HTMLAttributes<"video">,
  "src" | "poster" | "loop" | "autoplay" | "muted"
> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Video URL. Omit to render nothing. */
  src?: string;
  /** Poster image URL. */
  poster?: string;
};

type Tail = {
  /** Restart after playback. */
  loop?: boolean;
  /**
   * Play while on screen. Requires `muted`. Nothing downloads until the
   * video scrolls into view, and it pauses when it scrolls out.
   */
  autoplay?: boolean;
  /** Mute audio. */
  muted?: boolean;
  /** Fit without cropping and remove the skeleton tint. */
  transparent?: boolean;
  /** Play only from the `large` breakpoint. Smaller screens keep the poster and download nothing. */
  desktopOnly?: boolean;
  /**
   * Show a pause button over an autoplaying video. Defaults to `true` with
   * `autoplay`: moving content that plays for more than five seconds must be
   * pausable (WCAG 2.2.2). Turn it off only for a video of five seconds or
   * less that does not loop.
   */
  pauseButton?: boolean;
  /** Where the pause button sits over the video. Defaults to `bottom-right`. */
  pausePosition?:
    | "top-left"
    | "top"
    | "top-right"
    | "left"
    | "center"
    | "right"
    | "bottom-left"
    | "bottom"
    | "bottom-right";
};

type Props = Head &
  (
    | {
        /** Aspect ratio. */
        variant?: VideoRatio;
        ratio?: never;
      }
    | {
        variant: "custom";
        /** CSS `aspect-ratio` value. */
        ratio?: string;
      }
    | {
        variant: "auto";
        ratio?: never;
      }
  ) &
  Tail;

type AllProps = Head &
  Tail & {
    variant?: VideoRatio | "custom" | "auto";
    ratio?: string;
  };

const {
  render = true,
  src,
  poster,
  variant = "16-9",
  ratio,
  loop = true,
  autoplay = true,
  muted = true,
  transparent = false,
  desktopOnly = false,
  pauseButton = autoplay,
  pausePosition = "bottom-right",
  class: className,
  ...rest
} = Astro.props as AllProps;

if (import.meta.env.DEV && render) {
  if (!src) {
    console.warn(
      "[trix] <Video> rendered without a `src`; nothing was output.",
    );
  }
  if (autoplay && !muted) {
    console.warn(
      "[trix] <Video autoplay> without `muted` is blocked by every major browser. Set muted, or drop autoplay and let the viewer start it.",
    );
  }
  if (variant === "custom" && !ratio) {
    console.warn(
      '[trix] <Video variant="custom"> has no `ratio`, so no aspect ratio is applied. Set one, or pick a preset variant.',
    );
  }
}

const isCustom = variant === "custom";

// Auto margins against an inset box place the button: `auto` pushes it
// away from that side, `0` holds it there. Top, right, bottom, left.
const pauseMargins = {
  "top-left": "0 auto auto 0",
  top: "0 auto auto",
  "top-right": "0 0 auto auto",
  left: "auto auto auto 0",
  center: "auto",
  right: "auto 0 auto auto",
  "bottom-left": "auto auto 0 0",
  bottom: "auto auto 0",
  "bottom-right": "auto 0 0 auto",
};
---

{
  render && src && (
    <video
      src={src}
      poster={poster}
      class:list={[
        "video",
        !isCustom && `ratio-${variant}`,
        transparent && "transparent",
        className,
      ]}
      style={isCustom && ratio ? `aspect-ratio: ${ratio};` : undefined}
      loop={loop}
      preload={autoplay ? "none" : undefined}
      muted={muted}
      playsinline
      data-video-autoplay={autoplay ? "" : undefined}
      data-video-desktop-only={desktopOnly ? "" : undefined}
      {...rest}
    />
  )
}
{
  render && src && autoplay && pauseButton && (
    <Button
      variant="play"
      emphasis="secondary"
      pressed={true}
      class="video_toggle"
      style={
        pausePosition !== "bottom-right"
          ? `--_margin: ${pauseMargins[pausePosition]}`
          : undefined
      }
      data-video-toggle
    />
  )
}

<script>
  // An autoplaying video loads and plays only while on screen. Its pause
  // button, right after it, is the visitor's: once they pause, scrolling
  // never restarts it. Visitors who prefer less motion start it themselves.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const desktop = matchMedia("(width >= 62rem)");
  const stopped = new WeakSet<HTMLVideoElement>();
  const allowed = (video: HTMLVideoElement) =>
    !stopped.has(video) &&
    !reduced.matches &&
    (desktop.matches || !("videoDesktopOnly" in video.dataset));

  const seen = new IntersectionObserver((entries) => {
    for (const { target, isIntersecting } of entries) {
      const video = target as HTMLVideoElement;
      if (isIntersecting && allowed(video)) video.play().catch(() => {});
      else if (!isIntersecting) video.pause();
    }
  });

  for (const video of document.querySelectorAll<HTMLVideoElement>(
    "video[data-video-autoplay]",
  )) {
    if (reduced.matches) stopped.add(video);
    seen.observe(video);
    const toggle = video.nextElementSibling;
    if (
      !(toggle instanceof HTMLButtonElement) ||
      !toggle.matches("[data-video-toggle]")
    )
      continue;
    const show = (playing: boolean) => {
      toggle.setAttribute("aria-pressed", String(playing));
      toggle.setAttribute("aria-label", playing ? "Pause video" : "Play video");
    };
    show(!reduced.matches);
    video.addEventListener("play", () => show(true));
    video.addEventListener("ended", () => show(false));
    toggle.addEventListener("click", () => {
      if (video.paused) {
        stopped.delete(video);
        video.play().catch(() => show(false));
      } else {
        stopped.add(video);
        video.pause();
        show(false);
      }
    });
  }
</script>

<style is:global>
  @layer components {
    /* Over the video, at `pausePosition`. Positioned by the video's container — a
       Section background, a ContentWrapper or Card visual — so a standalone
       video needs a positioned parent. */
    .video_toggle {
      position: absolute;
      inset: var(--space-3);
      width: fit-content;
      height: fit-content;
      margin: var(--_margin, auto 0 0 auto);
      z-index: 1;
      pointer-events: auto;
    }
    /* Desktop only: below `large` the poster stands alone. */
    @media (width < 62rem) {
      [data-video-desktop-only] + .video_toggle {
        display: none;
      }
    }
  }
</style>
