---
import { Font, fontData } from "astro:assets";
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  COLOR_MODE,
} from "@/consts.ts";
import JsonLd from "@/components/utility/JsonLd.astro";
import { isNoindexRoute, pagePath } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";
import type { Theme } from "@/styles/generated/tokens.ts";

type Props = SeoProps & {
  /** The page's theme from `BaseLayout`. A pinned theme fixes the color scheme. */
  theme?: "inherit" | Theme;
};

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image.jpg",
  type = "website",
  noindex,
  schema,
  theme = "inherit",
} = Astro.props;

const path = pagePath(Astro.url);
const isNoindex = noindex ?? isNoindexRoute(path);
// Every family in astro.config.mjs `fonts`, whatever its provider. Only the
// first family's latin, normal-style file is preloaded: the body text.
const fonts = Object.keys(fontData) as (keyof typeof fontData)[];
const firstFiles = fonts[0] ? fontData[fonts[0]] : [];
const fontPreload = (
  firstFiles.find(
    (f) => f.style !== "italic" && (!f.subset || f.subset === "latin"),
  ) ?? firstFiles[0]
)?.src[0]?.url;

/* The color scheme the browser paints before the CSS loads: the system's,
   the fixed mode, or a pinned page theme's (any theme but `dark` counts as
   light). CSS follows the system on its own; the script only applies a
   stored ThemeToggle choice — before first paint, after each ClientRouter
   swap (which resets the root's attributes) and when another tab changes
   it. A pinned page keeps its scheme. */
const scheme =
  theme !== "inherit"
    ? theme === "dark"
      ? "dark"
      : "light"
    : COLOR_MODE === "auto"
      ? "light dark"
      : COLOR_MODE;
const colorModeScript = `(() => {
  const root = document.documentElement;
  const apply = () => {
    let mode;
    try { mode = localStorage.getItem("trix-mode"); } catch {}
    if (mode) root.dataset.mode = mode;
    else delete root.dataset.mode;
    if (!root.matches('[class*="theme-"]'))
      document.querySelector('meta[name="color-scheme"]').content = mode || "light dark";
  };
  apply();
  document.addEventListener("astro:after-swap", apply);
  addEventListener("storage", (e) => {
    if (e.key === "trix-mode" || e.key === null) apply();
  });
})();`;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(path, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="text-scale" content="scale" />
<meta name="color-scheme" content={scheme} />
{COLOR_MODE === "auto" && <script is:inline set:html={colorModeScript} />}
{fonts.map((cssVariable) => <Font cssVariable={cssVariable} />)}
{
  fontPreload && (
    <link
      rel="preload"
      href={fontPreload}
      as="font"
      type="font/woff2"
      crossorigin
    />
  )
}
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:locale" content={SITE_LOCALE.replace("-", "_")} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
{schema && <JsonLd data={schema} />}
