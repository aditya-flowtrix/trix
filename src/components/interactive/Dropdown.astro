---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow.svg";
import { slotContent } from "@/utils/slots.ts";
import { uid } from "@/utils/unique-id.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Trigger text. */
  label?: string;
  /** In a nav, `menu` and `mega` open in the flow of the mobile menu; from `medium` up, `menu` floats like `default` and `mega` spans the nav's full width. */
  variant?: "default" | "menu" | "mega";
  /** Keep the panel open in design mode. */
  preview?: boolean;
};

const {
  render = true,
  label,
  variant = "default",
  preview = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
const id = uid("dropdown");
---

{
  render && label && content && (
    <div
      class:list={[
        "dropdown_wrap",
        variant !== "default" && variant,
        preview && "preview",
        className,
      ]}
      {...rest}
    >
      <button
        class="dropdown_toggle"
        type="button"
        aria-expanded="false"
        aria-controls={id}
        popovertarget={id}
      >
        <span class="dropdown_label text-style-trim">{label}</span>
        <Icon class="dropdown_icon" src={arrow} variant="small" />
      </button>

      <div class="dropdown_content" id={id} popover="auto">
        <div class="dropdown_body margin-trim">
          <Fragment set:html={content} />
        </div>
      </div>
    </div>
  )
}

<script>
  import { mount } from "@/utils/mount.ts";

  mount(".dropdown_wrap", (dropdown, signal) => {
    const toggle =
      dropdown.querySelector<HTMLButtonElement>(".dropdown_toggle");
    const panel = dropdown.querySelector<HTMLElement>(".dropdown_content");
    if (!toggle || !panel) return;

    // In a nav's phone menu, `menu` and `mega` open in its flow: a top-layer
    // popover can't, so there the panel is a disclosure toggled with `hidden`.
    const inline = dropdown.matches(".menu, .mega")
      ? matchMedia("(width < 48rem)")
      : null;
    const layout = () => {
      const flow = !!inline?.matches;
      if (flow) panel.removeAttribute("popover");
      else panel.setAttribute("popover", "auto");
      panel.hidden = flow;
      toggle.setAttribute("aria-expanded", "false");
    };
    layout();
    inline?.addEventListener("change", layout, { signal });

    panel.addEventListener("toggle", (event) => {
      toggle.setAttribute("aria-expanded", String(event.newState === "open"));
    });

    toggle.addEventListener("click", () => {
      if (panel.hasAttribute("popover")) return;
      panel.hidden = !panel.hidden;
      toggle.setAttribute("aria-expanded", String(!panel.hidden));
    });

    // Tabbing past the panel closes it, so it never covers what has focus.
    dropdown.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (
        next instanceof Node &&
        !dropdown.contains(next) &&
        panel.matches(":popover-open")
      )
        panel.hidePopover();
    });
  });
</script>

<style is:global>
  @layer components {
    .dropdown_wrap {
      --_control-pad: 0.75em;
      --_leaving: calc(var(--open-duration) * 0.7);
      --_from: 0 -0.5rem;
      position: relative;
      z-index: 10;
      display: inline-block;
    }

    .dropdown_toggle {
      display: flex;
      align-items: center;
      gap: 0.5em;
      padding: var(--_control-pad) 0;
      color: inherit;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
    }

    .dropdown_icon {
      flex: none;
      rotate: 90deg;
      @media (prefers-reduced-motion: no-preference) {
        transition: rotate var(--open-duration) var(--open-ease);
      }
    }

    .dropdown_toggle[aria-expanded="true"] .dropdown_icon,
    .dropdown_wrap:is(.stacki-opened, .stacki-designer .preview)
      .dropdown_icon {
      rotate: -90deg;
    }

    /* The floating panel: a popover anchored to its button, flipping to
       whichever side has room. Without anchor positioning it keeps the
       browser's centred placement. */
    .dropdown_content[popover] {
      width: max-content;
      max-width: min(22rem, calc(100vw - var(--site-margin) * 2));
      padding: 0;
      border: 0;
      border-radius: var(--radius-small);
      background-color: var(--background-2);
      color: inherit;
      transform-origin: top left;
      opacity: 0;
      transition-property: opacity, translate, scale;
      transition-duration: var(--_leaving);
      transition-timing-function: var(--open-ease);

      @supports (overlay: auto) {
        transition-property: opacity, translate, scale, display, overlay;
        transition-behavior: allow-discrete;
      }

      @supports (position-area: block-end) {
        inset: auto;
        min-width: anchor-size(width);
        margin: calc(var(--space-2) - var(--_control-pad)) 0 0;
        position-area: block-end span-inline-end;
        position-try-fallbacks:
          flip-block,
          flip-inline,
          flip-block flip-inline;
      }

      @media (prefers-reduced-motion: no-preference) {
        translate: var(--_from);
        scale: 0.98;
      }

      &:popover-open {
        opacity: 1;
        translate: none;
        scale: none;
        transition-duration: var(--open-duration);

        @starting-style {
          opacity: 0;
          @media (prefers-reduced-motion: no-preference) {
            translate: var(--_from);
            scale: 0.98;
          }
        }
      }
    }

    /* The builder cannot open a popover, so its own classes show the panel
       under the button, as `Modal` does. */
    .dropdown_wrap:is(.stacki-opened, .stacki-designer .preview)
      .dropdown_content {
      display: block;
      opacity: 1;
      translate: none;
      scale: none;
      &[popover] {
        position: absolute;
        inset-block: 100% auto;
        margin: 0;
      }
    }

    .dropdown_body {
      padding: var(--space-5);
    }

    /* A block, so it lines up with the links beside it rather than sitting
       on a text baseline. */
    .dropdown_wrap:is(.menu, .mega) {
      display: block;
    }

    /* In a nav's phone menu the panel opens in the flow, under its button. */
    @media (width < 48rem) {
      .dropdown_wrap:is(.menu, .mega) {
        & .dropdown_toggle {
          width: 100%;
          justify-content: space-between;
        }
        & .dropdown_body {
          padding: 0 0 var(--space-3);
        }
      }
    }

    /* Mega: the panel hangs from the nav's bottom edge, full width, its
       content as wide as the page's. */
    @media (width >= 48rem) {
      .dropdown_wrap.mega {
        position: static;
        & .dropdown_content[popover] {
          width: auto;
          max-width: none;
          border-radius: 0;
          transform-origin: top center;
          @supports (position-area: block-end) {
            position-area: none;
            position-try-fallbacks: none;
            inset-block-start: anchor(bottom);
            inset-inline: 0;
            margin: 0;
          }
        }
        & .dropdown_body {
          max-width: var(--max-width-main);
          margin-inline: auto;
          padding: var(--space-6) var(--site-margin);
        }
      }
    }
  }
</style>
