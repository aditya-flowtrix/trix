---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent, topElements } from "@/utils/slots.ts";
import { uid } from "@/utils/unique-id.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Accessible label. Defaults to `Tabs`. */
  label?: string;
  /** Tab layout. */
  variant?: "horizontal" | "side";
  /** Panel playback. */
  playback?: "manual" | "auto";
  /** Show all panels in design mode. */
  preview?: boolean;
};

const {
  render = true,
  label = "Tabs",
  variant = "horizontal",
  playback = "manual",
  preview = false,
  class: className,
  ...rest
} = Astro.props;

const auto = playback === "auto";
const id = uid("tabs");

/* The first tab is selected in the HTML, so the page reads right before any
   script runs; the script moves the selection from the URL. */
let tab = 0;
const links = (await slotContent(Astro.slots, "links")).replaceAll(
  "data-tab-link",
  () => {
    const i = tab++;
    return `role="tab" id="${id}-${i}" aria-selected="${i === 0}" tabindex="${i === 0 ? 0 : -1}"`;
  },
);

// Each panel gets a wrapper of its own: `hidden="until-found"` hides a box's
// contents but not its padding or background, so those stay on the panel's
// own element, inside it.
const panels = topElements(await slotContent(Astro.slots));
---

{
  render && links && panels.length > 0 && (
    <div
      class:list={[
        "tabs_wrap",
        variant !== "horizontal" && variant,
        auto && "auto",
        preview && "preview",
        className,
      ]}
      {...rest}
    >
      <div class="tabs_bar">
        <div
          class="tabs_links"
          role="tablist"
          aria-label={label}
          aria-orientation={variant === "side" ? "vertical" : "horizontal"}
        >
          <Fragment set:html={links} />
        </div>
      </div>

      <div class="tabs_panels">
        {panels.map((panel, i) => (
          <div
            class="tabs_panel"
            role="tabpanel"
            aria-labelledby={`${id}-${i}`}
            hidden={i > 0 ? "until-found" : undefined}
          >
            <Fragment set:html={panel} />
          </div>
        ))}
      </div>

      {auto && (
        <div class="tabs_controls">
          <div class="tabs_steps">
            <Button
              variant="arrow"
              emphasis="secondary"
              direction="back"
              label="Previous tab"
              data-step="-1"
            />
            <Button
              variant="arrow"
              emphasis="secondary"
              label="Next tab"
              data-step="1"
            />
          </div>
          <Button
            variant="play"
            emphasis="secondary"
            label="Pause automatic rotation"
            pressed
            data-toggle
          />
        </div>
      )}
    </div>
  )
}

{}
<noscript>
  <style>
    .tabs_bar,
    .tabs_controls {
      display: none;
    }
    .tabs_wrap {
      grid-template-columns: none;
    }
    .tabs_panels {
      display: grid;
      gap: var(--space-6);
      overflow: visible;
    }
    .tabs_panel[hidden] {
      display: block;
      content-visibility: visible;
    }
  </style>
</noscript>

<script>
  import { mount } from "@/utils/mount.ts";
  import { slug } from "@/utils/slug.ts";

  const INTERVAL = 6000;
  const FOCUSABLE =
    'a[href], button, input, select, textarea, summary, iframe, [contenteditable], [tabindex]:not([tabindex="-1"])';

  mount(".tabs_wrap", (tabs, signal) => {
    const bar = tabs.querySelector<HTMLElement>(
      ":scope > .tabs_bar > .tabs_links",
    );
    const links = [
      ...tabs.querySelectorAll<HTMLButtonElement>(
        ":scope > .tabs_bar .tabs_link",
      ),
    ];
    const panels = [
      ...tabs.querySelectorAll<HTMLElement>(
        ":scope > .tabs_panels > .tabs_panel",
      ),
    ];
    if (!bar || links.length === 0 || links.length !== panels.length) return;

    const auto = tabs.classList.contains("auto");
    const toggle = tabs.querySelector<HTMLButtonElement>(
      ":scope > .tabs_controls [data-toggle]",
    );
    // A panel with nothing to focus is a tab stop itself, so a keyboard can
    // reach it to scroll or read it.
    const stops = panels.map((panel) => !panel.querySelector(FOCUSABLE));

    // In view, clear of the faded ends: the bar's scroll padding is a fade.
    const keepInView = (link: HTMLElement) => {
      const pad =
        parseFloat(getComputedStyle(bar).scrollPaddingInlineStart) || 0;
      const list = bar.getBoundingClientRect();
      const box = link.getBoundingClientRect();
      if (box.left < list.left + pad)
        bar.scrollBy({ left: box.left - list.left - pad });
      else if (box.right > list.right - pad)
        bar.scrollBy({ left: box.right - list.right + pad });
    };

    let current = 0;
    let timer: number | undefined;
    let paused = false;
    signal.addEventListener("abort", () => window.clearTimeout(timer));

    // Tabs without an id keep their own place in the URL: `tab` for the
    // first on the page, then `tab-2`, `tab-3`. A tab with no text, only an
    // icon, is linked by its position.
    const unnamed = [
      ...document.querySelectorAll(".tabs_wrap:not([id])"),
    ].indexOf(tabs);
    const key = tabs.id || (unnamed > 0 ? `tab-${unnamed + 1}` : "tab");
    const slugs = links.map(
      (link, i) => slug(link.textContent ?? "") || String(i + 1),
    );

    const remember = (index: number) => {
      const url = new URL(location.href);
      url.searchParams.set(key, slugs[index]);
      history.replaceState(history.state, "", url);
    };

    const restart = () => {
      window.clearTimeout(timer);
      if (!auto || paused) return;
      tabs.classList.remove("running");
      void tabs.offsetWidth;
      tabs.classList.add("running");
      timer = window.setTimeout(
        () => show(current + 1, false, false),
        INTERVAL,
      );
    };

    const show = (next: number, focus = false, share = true) => {
      const index = (next + links.length) % links.length;
      if (index !== current && tabs.classList.contains("is-ready")) {
        tabs.style.setProperty("--_dir", next > current ? "1" : "-1");
        tabs.dataset.moved = "";
      }

      links.forEach((link, i) => {
        link.setAttribute("aria-selected", String(i === index));
        link.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        if (i === index) panel.removeAttribute("hidden");
        else panel.setAttribute("hidden", "until-found");
        if (i === index && stops[i]) panel.tabIndex = 0;
        else panel.removeAttribute("tabindex");
      });

      current = index;
      if (share) remember(index);
      if (focus) links[index].focus();
      keepInView(links[index]);
      restart();
    };

    links.forEach((link, i) => {
      link.addEventListener("click", () => show(i));
      link.addEventListener("keydown", (event) => {
        const moves: Record<string, number | undefined> = {
          ArrowRight: current + 1,
          ArrowDown: current + 1,
          ArrowLeft: current - 1,
          ArrowUp: current - 1,
          Home: 0,
          End: links.length - 1,
        };
        const to = moves[event.key];
        if (to === undefined) return;
        event.preventDefault();
        show(to, true);
      });
    });

    // Hidden panels stay findable: find-in-page shows one by selecting its tab.
    panels[0].parentElement!.addEventListener("beforematch", (event) => {
      const i = panels.indexOf(event.target as HTMLElement);
      if (i !== -1) show(i);
    });

    for (const step of tabs.querySelectorAll<HTMLButtonElement>(
      ":scope > .tabs_controls [data-step]",
    )) {
      step.addEventListener("click", () =>
        show(current + Number(step.dataset.step)),
      );
    }

    // Where scroll-driven animations aren't, the fades follow which ends of
    // the bar have tabs out of view.
    if (!CSS.supports("animation-timeline", "scroll()")) {
      const ends = new IntersectionObserver(
        (entries) => {
          for (const { target, intersectionRatio } of entries)
            bar.classList.toggle(
              target === links[0] ? "more-start" : "more-end",
              intersectionRatio < 1,
            );
        },
        { root: bar, threshold: 1, rootMargin: "1px" },
      );
      ends.observe(links[0]);
      ends.observe(links[links.length - 1]);
      signal.addEventListener("abort", () => ends.disconnect());
    }

    const setPaused = (value: boolean) => {
      paused = value;
      tabs.classList.toggle("is-paused", value);
      toggle?.toggleAttribute("data-playing", !value);
      toggle?.setAttribute(
        "aria-label",
        value ? "Start automatic rotation" : "Pause automatic rotation",
      );
      restart();
    };

    const asked = new URLSearchParams(location.search).get(key);
    const wanted = asked ? slugs.indexOf(slug(asked)) : -1;
    show(wanted === -1 ? 0 : wanted, false, false);
    if (wanted !== -1) tabs.scrollIntoView({ block: "nearest" });
    tabs.classList.add("is-ready");

    if (!auto) return;

    toggle?.addEventListener("click", () => {
      holds.asked = false;
      setPaused(!paused);
    });

    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const holds = {
      motion: motion.matches,
      focus: false,
      offscreen: false,
      asked: wanted !== -1,
    };
    const settle = () => setPaused(Object.values(holds).some(Boolean));

    motion.addEventListener(
      "change",
      (event) => {
        holds.motion = event.matches;
        settle();
      },
      { signal },
    );
    tabs.addEventListener("focusin", () => {
      holds.focus = true;
      settle();
    });
    tabs.addEventListener("focusout", (event) => {
      if (tabs.contains(event.relatedTarget as Node)) return;
      holds.focus = false;
      settle();
    });
    const seen = new IntersectionObserver((entries) => {
      holds.offscreen = !entries[0].isIntersecting;
      settle();
    });
    seen.observe(tabs);
    signal.addEventListener("abort", () => seen.disconnect());

    settle();
  });
</script>

<style is:global>
  @property --_fade-start {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  @property --_fade-end {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  @layer components {
    .tabs_wrap {
      --_dir: 1;
      --_interval: 6s;
      --_slide: 500ms;
      display: grid;
      gap: var(--space-6);
      width: 100%;

      &.side {
        @media (width >= 48rem) {
          grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
          align-items: start;
        }
      }
    }

    .tabs_bar {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    /* A row too long for its space scrolls, each end that has tabs beyond
       it faded. The fades grow with the scroll position; the script sets
       more-start and more-end where scroll-driven animations aren't. */
    .tabs_links {
      --_fade-size: var(--space-7);
      --_fade-dir: right;
      --_fade-start-at: 0%;
      --_fade-end-at: 100%;
      display: flex;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-padding-inline: var(--_fade-size);
      mask:
        linear-gradient(black, black) no-clip subtract,
        linear-gradient(to var(--_fade-dir), black, transparent)
          var(--_fade-start-at) 0 / var(--_fade-start) 100% no-repeat no-clip,
        linear-gradient(to var(--_fade-dir), transparent, black)
          var(--_fade-end-at) 0 / var(--_fade-end) 100% no-repeat no-clip;
      transition:
        --_fade-start var(--hover-duration) var(--hover-ease),
        --_fade-end var(--hover-duration) var(--hover-ease);

      &:dir(rtl) {
        --_fade-dir: left;
        --_fade-start-at: 100%;
        --_fade-end-at: 0%;
      }
      &.more-start {
        --_fade-start: var(--_fade-size);
      }
      &.more-end {
        --_fade-end: var(--_fade-size);
      }
      @supports (animation-timeline: scroll()) {
        animation:
          tabs-fade-start linear both,
          tabs-fade-end linear both;
        animation-timeline: scroll(self inline);
        animation-range:
          0 var(--_fade-size),
          calc(100% - var(--_fade-size)) 100%;
      }

      .tabs_wrap.side & {
        flex-direction: column;
        gap: var(--space-2);
        overflow-x: visible;
        mask: none;
        animation: none;
      }
    }

    @keyframes tabs-fade-start {
      to {
        --_fade-start: var(--_fade-size);
      }
    }

    @keyframes tabs-fade-end {
      from {
        --_fade-end: var(--_fade-size);
      }
    }

    .tabs_link {
      position: relative;
      flex: 1;
      min-width: 8rem;
      padding-block: var(--space-3);
      background: none;
      border-bottom: var(--border-width) solid var(--border);
      color: var(--text-2);
      text-align: center;
      transition:
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      /* Selected is a line as well as a color, drawn as a border so forced
         colors keep it, and laid over the tab so it never resizes it. */
      &[aria-selected="true"] {
        color: var(--text);
        &::after {
          content: "";
          position: absolute;
          inset-inline: 0;
          inset-block-end: calc(var(--border-width) * -1);
          border-block-end: calc(var(--border-width) * 3) solid;
        }
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
      .tabs_wrap.side & {
        flex: none;
        min-width: 0;
        padding: var(--space-3) var(--space-5);
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-round);
        text-align: start;
        &[aria-selected="true"] {
          background-color: var(--text);
          color: var(--background);
          &::after {
            inset-block: var(--space-3);
            inset-inline: var(--space-2) auto;
            border-block-end: 0;
            border-inline-start: calc(var(--border-width) * 3) solid;
          }
        }
      }
    }

    /* Rotating, the selected tab's line fills over the time it is shown. */
    .tabs_wrap.auto.running:not(.side, .is-paused)
      > .tabs_bar
      .tabs_link[aria-selected="true"] {
      @media (prefers-reduced-motion: no-preference) {
        &::after {
          transform-origin: left;
          animation: tabs-progress var(--_interval) linear forwards;
        }
        &:dir(rtl)::after {
          transform-origin: right;
        }
      }
    }

    @keyframes tabs-progress {
      from {
        scale: 0 1;
      }
      to {
        scale: 1 1;
      }
    }

    .tabs_panels {
      min-width: 0;
      .tabs_wrap.auto > & {
        overflow: clip;
      }
    }

    /* The panel coming in, once the selection has moved — never on load. */
    .tabs_wrap[data-moved] > .tabs_panels > .tabs_panel:not([hidden]) {
      animation: tabs-in var(--open-duration) var(--open-ease);
    }

    .tabs_wrap.auto[data-moved] > .tabs_panels > .tabs_panel:not([hidden]) {
      @media (prefers-reduced-motion: no-preference) {
        animation: tabs-slide var(--_slide) var(--open-ease);
      }
    }

    @keyframes tabs-in {
      from {
        opacity: 0;
      }
    }

    @keyframes tabs-slide {
      from {
        translate: calc(var(--_dir) * 100%) 0;
        opacity: 0;
      }
    }

    /* Design mode lays the panels out one after another, the same way the
       `noscript` fallback above does, so every one can be edited. The bar
       stays put so the links can be edited too. */
    .stacki-designer .tabs_wrap.preview .tabs_panels {
      display: grid;
      gap: var(--space-6);
      overflow: visible;
    }

    .stacki-designer .tabs_wrap.preview .tabs_panel {
      animation: none;
      &[hidden] {
        display: block;
        content-visibility: visible;
      }
    }

    .tabs_controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .tabs_steps {
      display: flex;
      gap: var(--space-2);
    }
  }
</style>
