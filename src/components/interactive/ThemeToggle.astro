---
import type { HTMLAttributes } from "astro/types";
import { COLOR_MODE } from "@/consts.ts";

interface Props extends HTMLAttributes<"button"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Accessible name while the page is light. */
  darkLabel?: string;
  /** Accessible name while the page is dark. */
  lightLabel?: string;
}

const {
  render = true,
  darkLabel = "Switch to dark mode",
  lightLabel = "Switch to light mode",
  class: className,
  ...rest
} = Astro.props;
---

{
  render && COLOR_MODE === "auto" && (
    <button
      type="button"
      class:list={["theme-toggle_wrap", className]}
      {...rest}
    >
      <span class="theme-toggle_thumb" aria-hidden="true" />
      <span class="theme-toggle_to-dark sr-only">{darkLabel}</span>
      <span class="theme-toggle_to-light sr-only">{lightLabel}</span>
    </button>
  )
}

<script>
  import { COLOR_MODE } from "@/consts.ts";
  import { mount } from "@/utils/mount.ts";

  // In "light" or "dark" the switch never renders, and this is false at
  // build time, so the bundle drops it all.
  if (COLOR_MODE === "auto") {
    const KEY = "trix-mode";
    const root = document.documentElement;
    const system = matchMedia("(prefers-color-scheme: dark)");

    // Two states: the system's, and its opposite. A click shows the opposite
    // of what the page shows; landing back on the system's mode forgets the
    // choice, so the page follows the system again.
    mount(".theme-toggle_wrap", (button) => {
      button.addEventListener("click", () => {
        const os = system.matches ? "dark" : "light";
        const next = (root.dataset.mode ?? os) === "dark" ? "light" : "dark";
        const mode = next === os ? null : next;
        try {
          if (mode) localStorage.setItem(KEY, mode);
          else localStorage.removeItem(KEY);
        } catch {}
        if (mode) root.dataset.mode = mode;
        else delete root.dataset.mode;
        document
          .querySelector('meta[name="color-scheme"]')
          ?.setAttribute("content", mode ?? "light dark");
      });
    });
  }
</script>

<style is:global>
  @layer components {
    .theme-toggle_wrap {
      position: relative;
      flex: none;
      display: inline-flex;
      align-items: center;
      width: 2.75em;
      height: 1.5em;
      padding: 0.1875em;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      background-color: var(--background-2);
      transition: background-color var(--hover-duration) var(--hover-ease);

      .theme-toggle_thumb {
        width: 1.125em;
        height: 1.125em;
        border-radius: var(--radius-round);
        background-color: var(--text);

        @media (prefers-reduced-motion: no-preference) {
          transition: translate var(--open-duration) var(--open-ease);
        }

        @media (forced-colors: active) {
          forced-color-adjust: none;
          background-color: ButtonText;
        }
      }

      .theme-toggle_to-light {
        display: none;
      }

      /* Where the page is dark: set, or the system's with no light mode set.
         CSS, so it is right before any script runs. */
      :root[data-mode="dark"] & {
        .theme-toggle_thumb {
          translate: 1.25em 0;
        }
        .theme-toggle_to-dark {
          display: none;
        }
        .theme-toggle_to-light {
          display: inline;
        }
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-mode="light"]) & {
          .theme-toggle_thumb {
            translate: 1.25em 0;
          }
          .theme-toggle_to-dark {
            display: none;
          }
          .theme-toggle_to-light {
            display: inline;
          }
        }
      }
    }
  }
</style>
