---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Accessible label. Defaults to `Slider`. */
  label?: string;
  /** Slider bounds. */
  variant?: "bleed" | "crop-start" | "contained";
  /** Slides shown below 30rem. Defaults to `1.02`.
   *
   * @min 1
   * @max 12 */
  xsmall?: number;
  /** Slides shown from 30rem. Inherits `xsmall`.
   *
   * @min 1
   * @max 12 */
  small?: number;
  /** Slides shown from 48rem. Inherits `small`.
   *
   * @min 1
   * @max 12 */
  medium?: number;
  /** Slides shown from 62rem. Inherits `medium`.
   *
   * @min 1
   * @max 12 */
  large?: number;
  /** Wrap from the last slide to the first, and back. */
  loop?: boolean;
  /** Slide playback. `auto` advances every six seconds and loops, with a pause button. */
  playback?: "manual" | "auto";
  /** Controls placement. `top` sets them above the slides, beside the `header` slot. */
  controls?: "bottom" | "top";
  /** Show a dot for each position. Set to `false` for arrows only. */
  markers?: boolean;
};

const {
  render = true,
  label = "Slider",
  variant = "bleed",
  xsmall = 1.02,
  small,
  medium,
  large,
  loop = false,
  playback = "manual",
  controls = "bottom",
  markers = true,
  class: className,
  ...rest
} = Astro.props;

const counts = { xs: xsmall, sm: small, md: medium, lg: large };

const invalid = Object.entries(counts).filter(
  ([, count]) => count !== undefined && !(Number.isFinite(count) && count > 0),
);

if (import.meta.env.DEV && invalid.length) {
  console.warn(
    `[trix] <Slider> ignores ${invalid.map(([size]) => size).join(", ")}: slides in view must be greater than 0.`,
  );
}

const set = (count: number | undefined) =>
  count !== undefined && Number.isFinite(count) && count > 0;

const visible =
  [
    xsmall !== 1.02 && set(xsmall) && `--_visible-xs: ${xsmall}`,
    set(small) && `--_visible-sm: ${small}`,
    set(medium) && `--_visible-md: ${medium}`,
    set(large) && `--_visible-lg: ${large}`,
  ]
    .filter(Boolean)
    .join("; ") || undefined;

const slides = await slotContent(Astro.slots);
const header = await slotContent(Astro.slots, "header");
---

{
  render && slides && (
    <div
      class:list={[
        "slider_wrap",
        variant !== "bleed" && variant,
        loop && "loop",
        playback === "auto" && "auto",
        controls === "top" && "controls-top",
        className,
      ]}
      style={visible}
      {...rest}
    >
      {header && (
        <div class="slider_header">
          <Fragment set:html={header} />
        </div>
      )}
      <div class="slider_list" role="group" aria-label={label} tabindex="0">
        <Fragment set:html={slides} />
      </div>

      <div class="slider_controls">
        {markers && <div class="slider_markers" />}
        <div class="slider_steps">
          <Button
            variant="arrow"
            emphasis="secondary"
            direction="back"
            label="Previous slide"
            data-step="-1"
          />
          <Button
            variant="arrow"
            emphasis="secondary"
            label="Next slide"
            data-step="1"
          />
        </div>
        {playback === "auto" && (
          <Button
            variant="play"
            emphasis="secondary"
            label="Pause automatic rotation"
            pressed
            data-toggle
          />
        )}
      </div>
    </div>
  )
}

<script>
  const THRESHOLD = 4;

  for (const slider of document.querySelectorAll<HTMLElement>(".slider_wrap")) {
    const list = slider.querySelector<HTMLElement>(".slider_list");
    const markers = slider.querySelector<HTMLElement>(".slider_markers");
    const controls = slider.querySelector<HTMLElement>(".slider_controls");
    const steps = [
      ...slider.querySelectorAll<HTMLButtonElement>("[data-step]"),
    ];
    if (!list) continue;

    const slides = [...list.children] as HTMLElement[];
    if (slides.length === 0) continue;

    slides.forEach((slide, i) => {
      slide.setAttribute("role", "group");
      slide.setAttribute("aria-label", `${i + 1} of ${slides.length}`);
    });

    const auto = slider.classList.contains("auto");
    const loop = auto || slider.classList.contains("loop");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const behavior = () => (reduced.matches ? "auto" : "smooth");

    const stride = () => {
      const first = slides[0].getBoundingClientRect();
      if (slides.length < 2) return first.width;
      return slides[1].getBoundingClientRect().left - first.left;
    };

    const view = () => {
      const box = getComputedStyle(list);
      return (
        list.clientWidth -
        parseFloat(box.paddingInlineStart) -
        parseFloat(box.paddingInlineEnd)
      );
    };

    const pages = () => {
      const step = stride();
      if (step <= 0) return 1;
      return Math.max(1, slides.length - Math.round(view() / step) + 1);
    };

    const current = () => {
      const step = stride();
      return step > 0 ? Math.round(list.scrollLeft / step) : 0;
    };

    let drawn = 0;

    const draw = (total: number) => {
      if (!markers) return;
      drawn = total;
      markers.replaceChildren(
        ...Array.from({ length: total }, (_, i) => {
          const marker = document.createElement("button");
          marker.type = "button";
          marker.className = "slider_marker";
          marker.setAttribute("aria-label", `Go to slide ${i + 1}`);
          marker.addEventListener("click", () =>
            list.scrollTo({ left: i * stride(), behavior: behavior() }),
          );
          return marker;
        }),
      );
    };

    const sync = () => {
      const total = pages();
      if (total !== drawn) draw(total);

      const end = list.scrollWidth - list.clientWidth;
      const atStart = list.scrollLeft <= 1;
      const atEnd = list.scrollLeft >= end - 1;

      for (const step of steps) {
        step.disabled =
          !loop && (Number(step.dataset.step) < 0 ? atStart : atEnd);
      }

      const index = current();
      markers?.querySelectorAll(".slider_marker").forEach((marker, i) => {
        marker.classList.toggle("is-active", i === index);
        if (i === index) marker.setAttribute("aria-current", "true");
        else marker.removeAttribute("aria-current");
      });

      controls?.classList.toggle("is-empty", end <= 1);
    };

    // One step either way; looping, past an end comes round to the other.
    const go = (by: number) => {
      const end = list.scrollWidth - list.clientWidth;
      if (loop && by > 0 && list.scrollLeft >= end - 1)
        list.scrollTo({ left: 0, behavior: behavior() });
      else if (loop && by < 0 && list.scrollLeft <= 1)
        list.scrollTo({ left: end, behavior: behavior() });
      else list.scrollBy({ left: by * stride(), behavior: behavior() });
    };

    for (const step of steps) {
      step.addEventListener("click", () => {
        go(Number(step.dataset.step));
        restart();
      });
    }

    // Auto: a step every six seconds, held while it is focused, off screen,
    // paused by its button, or the visitor prefers less motion — as Tabs.
    const toggle = slider.querySelector<HTMLButtonElement>("[data-toggle]");
    let timer: number | undefined;
    let paused = !auto;
    const restart = () => {
      window.clearTimeout(timer);
      if (!paused) timer = window.setTimeout(() => (go(1), restart()), 6000);
    };
    const holds = {
      motion: reduced.matches,
      focus: false,
      offscreen: false,
      asked: false,
    };
    const settle = () => {
      paused = !auto || Object.values(holds).some(Boolean);
      slider.classList.toggle("is-paused", paused);
      toggle?.setAttribute("aria-pressed", String(!holds.asked));
      toggle?.setAttribute(
        "aria-label",
        holds.asked ? "Start automatic rotation" : "Pause automatic rotation",
      );
      restart();
    };
    if (auto) {
      toggle?.addEventListener("click", () => {
        holds.asked = !holds.asked;
        settle();
      });
      reduced.addEventListener("change", (event) => {
        holds.motion = event.matches;
        settle();
      });
      list.addEventListener("focusin", () => {
        holds.focus = true;
        settle();
      });
      list.addEventListener("focusout", (event) => {
        if (list.contains(event.relatedTarget as Node)) return;
        holds.focus = false;
        settle();
      });
      new IntersectionObserver((entries) => {
        holds.offscreen = !entries[0].isIntersecting;
        settle();
      }).observe(slider);
      settle();
    }

    let origin = 0;
    let from = 0;
    let pressed = false;
    let dragged = false;

    const restore = () => {
      if (!pressed) list.classList.remove("is-dragging");
    };

    list.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      if (list.scrollWidth <= list.clientWidth) return;
      pressed = true;
      dragged = false;
      origin = event.clientX;
      from = list.scrollLeft;
    });

    list.addEventListener("pointermove", (event) => {
      if (!pressed) return;
      const shift = event.clientX - origin;
      if (!dragged) {
        if (Math.abs(shift) < THRESHOLD) return;
        dragged = true;
        list.setPointerCapture(event.pointerId);
        list.classList.add("is-dragging");
      }
      list.scrollLeft = from - shift;
    });

    const release = () => {
      if (!pressed) return;
      pressed = false;
      const step = stride();
      if (dragged && step > 0) {
        list.scrollTo({
          left: Math.round(list.scrollLeft / step) * step,
          behavior: behavior(),
        });
      }
      list.addEventListener("scrollend", restore, { once: true });
      setTimeout(restore, 400);
    };

    list.addEventListener("pointerup", release);
    list.addEventListener("pointercancel", release);
    list.addEventListener("dragstart", (event) => event.preventDefault());

    list.addEventListener(
      "click",
      (event) => {
        if (!dragged) return;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

    let frame = 0;
    list.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(sync);
      },
      { passive: true },
    );

    slider.classList.add("is-ready");

    const resize = new ResizeObserver(sync);
    resize.observe(list);

    addEventListener("load", sync);
    sync();
  }
</script>

<style is:global>
  @layer components {
    .slider_wrap {
      --_gap-size: var(--site-gutter);
      --_edge: max(var(--site-margin), (100cqw - var(--max-width-main)) / 2);
      --_visible: var(--_visible-xs);
      --_visible-xs: 1.02;
      --_visible-sm: var(--_visible-xs);
      --_visible-md: var(--_visible-sm);
      --_visible-lg: var(--_visible-md);
      display: grid;
      gap: var(--space-6);
      width: 100%;

      @media (width >= 30rem) {
        --_visible: var(--_visible-sm);
      }
      @media (width >= 48rem) {
        --_visible: var(--_visible-md);
      }
      @media (width >= 62rem) {
        --_visible: var(--_visible-lg);
      }
    }

    .slider_list {
      display: flex;
      gap: var(--_gap-size);
      min-width: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      cursor: grab;
      margin-inline: calc(-1 * var(--_edge));
      padding-inline: var(--_edge);
      scroll-padding-inline: var(--_edge);

      &::-webkit-scrollbar {
        display: none;
      }

      &:active {
        cursor: grabbing;
      }

      &.is-dragging {
        scroll-snap-type: none;
        -webkit-user-select: none;
        user-select: none;
      }

      .slider_wrap:not(.is-ready) &,
      .slider_wrap:has(.slider_controls.is-empty) & {
        cursor: auto;
      }

      & > * {
        flex: 0 0
          calc(
            (100% - (var(--_visible) - 1) * var(--_gap-size)) / var(--_visible)
          );
        min-width: 0;
        scroll-snap-align: start;
      }

      .slider_wrap.crop-start & {
        margin-inline-start: 0;
        padding-inline-start: 0;
        scroll-padding-inline-start: 0;
      }

      .slider_wrap.contained & {
        margin-inline: 0;
        padding-inline: 0;
        scroll-padding-inline: 0;
      }
    }

    .slider_controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);

      .slider_wrap:not(.is-ready) &,
      &.is-empty {
        display: none;
      }

      &:not(:has(.slider_markers)) {
        justify-content: end;
      }
    }

    /* Controls above the slides, at the end of the header's row — the DOM
       keeps them after the slides, so they follow them in tab order. */
    .slider_wrap.controls-top {
      grid-template-columns: minmax(0, 1fr) auto;
      & > .slider_header {
        grid-area: 1 / 1;
        align-self: end;
      }
      & > .slider_controls {
        grid-area: 1 / 2;
        align-self: end;
      }
      & > .slider_list {
        grid-row: 2;
        grid-column: 1 / -1;
      }
    }

    .slider_markers {
      display: flex;
      align-items: center;
    }

    /* A 24px target (WCAG 2.2 target size) around the 12px dot it draws. */
    .slider_marker {
      display: grid;
      place-items: center;
      width: 1.5rem;
      height: 1.5rem;
      padding: 0;
      border: 0;
      background: none;
      &::before {
        content: "";
        width: 0.75rem;
        height: 0.75rem;
        border: var(--border-width) solid var(--text);
        border-radius: var(--radius-round);
        transition: background-color var(--hover-duration) var(--hover-ease);
      }
      &.is-active::before {
        background-color: var(--text);
      }
      @media (hover: hover) {
        &:hover::before {
          background-color: var(--text);
        }
      }
    }

    .slider_steps {
      display: flex;
      gap: var(--space-2);
    }
  }
</style>
