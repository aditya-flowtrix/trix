---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";
import { pagePath } from "@/utils/seo.ts";

type Props = HTMLAttributes<"a"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Link destination. The current URL is marked automatically. */
  href: string;
};

const { render = true, href, class: className, ...rest } = Astro.props;

/** Marks the link for the page being viewed, whatever the URL style. A
    `#` link — a placeholder or an anchor — never names the page. */
const current =
  !href.startsWith("#") &&
  pagePath(Astro.url) === pagePath(new URL(href, Astro.url))
    ? "page"
    : undefined;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <li>
      <a
        class:list={["nav_link", className]}
        href={href}
        aria-current={current}
        {...rest}
      >
        <Fragment set:html={content} />
      </a>
    </li>
  )
}
