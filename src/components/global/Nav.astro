---
import Icon from "@/components/media/Icon.astro";
import NavLink from "@/components/global/NavLink.astro";
import ThemeToggle from "@/components/interactive/ThemeToggle.astro";
import logo from "@/assets/logo/logo.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={logo} variant="full-width" />
        </a>
        <nav aria-label="Main">
          <button
            class="nav_toggle"
            type="button"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="nav-menu"
            popovertarget="nav-menu"
          >
            <span class="nav_toggle_icon" />
          </button>
          <div class="nav_menu" id="nav-menu" popover="auto">
            <ul class="nav_links">
              <NavLink href="/">Home</NavLink>
              <NavLink href="/style-guide">Style Guide</NavLink>
              <NavLink href="/components">Components</NavLink>
            </ul>
            {/* Renders only when COLOR_MODE is "auto". */}
            <ThemeToggle class="nav_theme" />
          </div>
        </nav>
      </div>
    </header>
  )
}

<script>
  import { mount } from "@/utils/mount.ts";

  mount(".nav_wrap", (nav, signal) => {
    const toggle = nav.querySelector<HTMLButtonElement>(".nav_toggle");
    const menu = nav.querySelector<HTMLElement>(".nav_menu");
    if (!toggle || !menu) return;

    // A popover only while the links are folded away; in the bar they are
    // a plain list. Escape and a click outside are the popover's own.
    const wide = matchMedia("(width >= 48rem)");
    const layout = () => {
      if (wide.matches) menu.removeAttribute("popover");
      else menu.setAttribute("popover", "auto");
      toggle.setAttribute("aria-expanded", "false");
    };
    layout();
    wide.addEventListener("change", layout, { signal });

    menu.addEventListener("toggle", (event) => {
      toggle.setAttribute("aria-expanded", String(event.newState === "open"));
    });

    menu.addEventListener("click", (event) => {
      const target = event.target;
      if (
        target instanceof Element &&
        target.closest("a") &&
        menu.matches(":popover-open")
      )
        menu.hidePopover();
    });
  });
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width) solid var(--border);
      anchor-name: --nav;

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 3.5rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        @media (prefers-reduced-motion: no-preference) {
          transition: transform var(--open-duration) var(--open-ease);
        }
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_toggle[aria-expanded="true"] .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    /* The phone menu: a popover hanging from the bar. Without anchor
       positioning, `inset-block` holds it under a bar of the usual height. */
    .nav_menu {
      --_from: 0 -0.5rem;
      inset-block: var(--nav-height) auto;
      inset-block-start: anchor(--nav bottom);
      inset-inline: 0;
      width: auto;
      max-height: calc(100dvh - var(--nav-height));
      margin: 0;
      padding: 0;
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      color: inherit;
      border: 0;
      border-bottom: var(--border-width) solid var(--border);
      opacity: 0;
      transition-property: opacity, translate;
      transition-duration: var(--open-duration);
      transition-timing-function: var(--open-ease);

      @supports (overlay: auto) {
        transition-property: opacity, translate, display, overlay;
        transition-behavior: allow-discrete;
      }

      @media (prefers-reduced-motion: no-preference) {
        translate: var(--_from);
      }

      &:popover-open {
        opacity: 1;
        translate: none;

        @starting-style {
          opacity: 0;
          @media (prefers-reduced-motion: no-preference) {
            translate: var(--_from);
          }
        }
      }
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--text-2);
      text-decoration: none;
      text-underline-offset: 0.4em;
      text-decoration-thickness: var(--border-width);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text);
        text-decoration: underline;
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    /* A Dropdown in the links: its trigger reads as a link, its links as a list. */
    .nav_links .dropdown_wrap {
      --_control-pad: var(--space-3);
    }

    .nav_links .dropdown_toggle {
      color: var(--text-2);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .nav_sub {
      display: flex;
      flex-direction: column;
      & .nav_link {
        padding-block: var(--space-2);
      }
    }

    .nav_theme {
      margin: 0 var(--site-margin) var(--space-4);
    }

    @media (width >= 48rem) {
      .nav_toggle {
        display: none;
      }

      .nav_theme {
        margin: 0;
      }

      /* In the bar. Shown here even while still a popover, before the
         script runs or without it. */
      .nav_menu {
        position: static;
        display: flex;
        align-items: center;
        gap: var(--space-4);
        max-height: none;
        overflow: visible;
        background-color: transparent;
        border-bottom: 0;
        opacity: 1;
        translate: none;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: var(--space-4);
        font-size: var(--text-small);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_links .dropdown_wrap {
        --_control-pad: 0rem;
      }

      /* The links sit at the bar's end: open toward the middle. */
      .nav_links .dropdown_wrap:not(.mega) .dropdown_content[popover] {
        position-area: block-end span-inline-start;
        transform-origin: top right;
      }

      /* A mega panel hangs from the bar's bottom edge. */
      .nav_links .mega .dropdown_content[popover] {
        position-anchor: --nav;
      }

      .nav_sub {
        gap: var(--space-3);
        & .nav_link {
          padding-block: 0;
        }
      }

      .nav_link {
        padding-block: 0;
      }
    }
  }
</style>
