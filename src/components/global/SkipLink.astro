---
import Button from "@/components/Button.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Target ID, without `#`. */
  target?: string;
  /** Link text. */
  label?: string;
}

const {
  render = true,
  target = "main",
  label = "Skip to main content",
} = Astro.props;
---

{
  render && (
    <Button element="link" href={`#${target}`} class="skip-link">
      {label}
    </Button>
  )
}

<script>
  // Following the link scrolls to the target; Safari leaves keyboard focus
  // behind. Move it, so the next Tab continues from the content.
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    ".skip-link",
  )) {
    link.addEventListener("click", () => {
      const target = document.getElementById(link.hash.slice(1));
      if (!target) return;
      if (!target.hasAttribute("tabindex")) target.tabIndex = -1;
      target.focus();
    });
  }
</script>

<style is:global>
  @layer components {
    .skip-link {
      position: fixed;
      top: var(--space-2);
      inset-inline-start: var(--space-2);
      z-index: 100;
      translate: 0 calc(-100% - var(--space-2) * 2);

      &:focus {
        translate: 0 0;
      }
    }
  }
</style>
