---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import { slug } from "@/utils/slug.ts";
import { uid } from "@/utils/unique-id.ts";

interface Props extends Omit<HTMLAttributes<"textarea">, "rows"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Field label. */
  label?: string;
  /** Initial value. */
  value?: string;
  /** Submitted name. Defaults to the label slug. */
  name?: string;
  /** Empty-field hint. */
  placeholder?: string;
  /** Message shown when the field is left invalid. */
  error?: string;
  /** Minimum visible lines. Defaults to `3`.
   *
   * @min 1
   * @int */
  minLines?: number;
  /** Maximum visible lines. Defaults to `12`.
   *
   * @min 1
   * @int */
  maxLines?: number;
  /** Require the field and mark its label. */
  required?: boolean;
}

const {
  render = true,
  label,
  value,
  name,
  placeholder,
  error,
  minLines = 3,
  maxLines = 12,
  required = false,
  id,
  class: className,
  ...rest
} = Astro.props;

const fieldId = id ?? uid("field");
const errorId = `${fieldId}-error`;
---

{
  render && label && (
    <div
      class:list={["field", "form-textarea", className]}
      style={`--_min-lines: ${minLines}; --_max-lines: ${maxLines};`}
    >
      <label class="field-label text-style-main" for={fieldId}>
        <span>{label}</span>
        {required && (
          <span class="field-star" aria-hidden="true">
            *
          </span>
        )}
      </label>
      <textarea
        class="field-control form-textarea_field text-style-main"
        id={fieldId}
        name={name ?? slug(label)}
        placeholder={placeholder}
        required={required || undefined}
        rows={minLines}
        data-error={error ? errorId : undefined}
        {...rest}
      >
        {value}
      </textarea>
      {error && (
        <p class="field-error text-style-small" id={errorId}>
          <Icon name="warning-circle" variant="small" aria-label="Error" />
          {error}
        </p>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .form-textarea_field {
      field-sizing: content;
      min-height: calc(
        var(--_min-lines, 3) * 1lh + var(--_field-pad-block) * 2 +
          var(--border-width) * 2
      );
      max-height: calc(
        var(--_max-lines, 12) * 1lh + var(--_field-pad-block) * 2 +
          var(--border-width) * 2
      );
      resize: vertical;
    }
  }
</style>
