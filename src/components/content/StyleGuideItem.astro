---
import type { HTMLAttributes } from "astro/types";
import StyleGuideCopy from "@/components/content/StyleGuideCopy.astro";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The name shown with the sample: a class, file or prop. */
  label: string;
  /** What clicking the name copies. Without it the name is plain text. */
  copy?: string;
  /** A line under the name: its values, or where it is used. */
  note?: string;
  /** Item style: no surface, a card, or a card in the dark theme. */
  variant?: "plain" | "card" | "dark";
}

const {
  render = true,
  label,
  copy,
  note,
  variant = "plain",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && label && content && (
    <div
      class:list={[
        "style-guide-item_wrap",
        variant !== "plain" && variant,
        variant === "dark" && "theme-dark",
        className,
      ]}
      {...rest}
    >
      <div class="style-guide-item_caption">
        {copy ? (
          <StyleGuideCopy text={copy} label={label} />
        ) : (
          <span class="style-guide-item_label">
            {label.split(/(?<=[/=])/).flatMap((part) => [part, <wbr />])}
          </span>
        )}
        {note && <span class="style-guide-item_note">{note}</span>}
      </div>
      <Fragment set:html={content} />
    </div>
  )
}

<style is:global>
  @layer components {
    .style-guide-item_wrap {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-4);
      min-width: 0;

      .style-guide-item_caption {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        max-width: 100%;
        font-size: var(--text-small);
        line-height: var(--text-small-line-height);
        font-variant-numeric: tabular-nums;
      }
      .style-guide-item_label {
        overflow-wrap: anywhere;
        font-weight: var(--primary-medium);
      }
      .style-guide-item_note {
        color: var(--text-2);
      }

      /* A card shows its sample first and names it underneath, as a
         gallery does. */
      &.card,
      &.dark {
        justify-content: space-between;
        height: 100%;
        padding: var(--space-4);
        border-radius: var(--radius-main);
        background-color: var(--background-2);

        .style-guide-item_caption {
          order: 1;
        }
      }
      &.dark {
        background-color: var(--background);
        border: var(--border-width) solid var(--border);
      }
    }
  }
</style>
