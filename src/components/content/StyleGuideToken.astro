---
import type { HTMLAttributes } from "astro/types";
import StyleGuideCopy from "@/components/content/StyleGuideCopy.astro";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Token name without the leading dashes. */
  token: string;
  /** Value shown under the token name. */
  value?: string;
  /** A line under the value: what uses it. */
  note?: string;
};

type Props = Base &
  (
    | {
        /** Token kind. */
        variant?: "color" | "space" | "radius";
        on?: never;
        ink?: never;
      }
    | {
        variant: "foreground";
        /** The color the text sits on. */
        on: string;
        ink?: never;
      }
    | {
        variant: "step";
        on?: never;
        /** The text color that reads on this step. */
        ink: "black" | "white";
      }
  );

type AllProps = Base & {
  variant?: "color" | "space" | "radius" | "foreground" | "step";
  on?: string;
  ink?: "black" | "white";
};

const {
  render = true,
  token,
  value,
  note,
  variant = "color",
  on,
  ink,
  class: className,
  ...rest
} = Astro.props as AllProps;

const style = [
  `--_token: var(--${token})`,
  on && `--_on: ${on}`,
  ink && `--_ink: var(--${ink})`,
]
  .filter(Boolean)
  .join("; ");
---

{
  render && token && (
    <div
      class:list={[
        "style-guide-token_wrap",
        variant !== "color" && variant,
        className,
      ]}
      style={style}
      {...rest}
    >
      {variant !== "step" && (
        <div class="style-guide-token_track" aria-hidden="true">
          <div class="style-guide-token_visual">
            {variant === "foreground" && "Aa"}
          </div>
        </div>
      )}
      <div class="style-guide-token_info">
        <StyleGuideCopy
          text={`var(--${token})`}
          label={
            variant === "step"
              ? token.slice(token.lastIndexOf("-") + 1)
              : `--${token}`
          }
        />
        {value && <span class="style-guide-token_value">{value}</span>}
        {note && <span class="style-guide-token_note">{note}</span>}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .style-guide-token_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      min-width: 0;

      .style-guide-token_visual {
        aspect-ratio: 4 / 3;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-main);
        background-color: var(--_token);
      }
      .style-guide-token_info {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: 0.125rem;
        min-width: 0;
        font-size: var(--text-small);
        line-height: var(--text-small-line-height);
        font-variant-numeric: tabular-nums;

        > .style-guide-copy_wrap {
          font-weight: var(--primary-medium);
        }
      }
      .style-guide-token_value,
      .style-guide-token_note {
        color: var(--text-2);
      }

      /* A space: name and values, then a bar drawn to scale. */
      &.space {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-3) var(--site-gutter);
        align-items: center;

        @media (width >= 48rem) {
          grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        }
        .style-guide-token_info {
          order: -1;
        }
        /* On a wide screen, one line each: name, value, use, bar. */
        @media (width >= 62rem) {
          grid-template-columns:
            minmax(0, 3fr) minmax(0, 2fr) minmax(0, 4fr)
            minmax(0, 3fr);
          .style-guide-token_info {
            display: contents;
          }
          .style-guide-token_track {
            order: 1;
          }
        }
        .style-guide-token_visual {
          width: var(--_token);
          max-width: 100%;
          height: 1rem;
          aspect-ratio: auto;
          border: 0;
          border-radius: var(--radius-xsmall);
          background-color: var(--button-background);
        }
      }

      &.foreground .style-guide-token_visual {
        display: grid;
        place-items: center;
        background-color: var(--_on);
        color: var(--_token);
        font-size: var(--h3);
        font-weight: var(--h3-font-weight);
      }

      &.radius .style-guide-token_visual {
        width: 100%;
        max-width: 7rem;
        aspect-ratio: 1;
        border: calc(var(--border-width) * 2) solid var(--text);
        border-radius: var(--_token);
        background-color: var(--background-2);
      }

      /* A step of a ramp: the swatch is the card, its step written on it;
         the ramp's title names it. */
      &.step {
        justify-content: end;
        min-height: 4rem;
        padding: var(--space-3);
        background-color: var(--_token);
        color: var(--_ink);

        .style-guide-token_value,
        .style-guide-token_note {
          color: inherit;
          opacity: 0.75;
        }
      }
    }
  }
</style>
