---
import Icon from "@/components/media/Icon.astro";
import StyleGuideGroup from "@/components/content/StyleGuideGroup.astro";
import StyleGuideItem from "@/components/content/StyleGuideItem.astro";
import type { SvgComponent } from "astro/types";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const phosphor = [
  "arrow-right",
  "check",
  "x",
  "list",
  "magnifying-glass",
  "envelope-simple",
  "phone",
  "map-pin",
  "download-simple",
  "play",
];
const weights = [
  "thin",
  "light",
  "regular",
  "bold",
  "fill",
  "duotone",
] as const;
const customIcons = Object.entries(
  import.meta.glob<{ default: SvgComponent }>("@/assets/icons/*.svg", {
    eager: true,
  }),
).map(([path, mod]) => ({
  name: path.split("/").pop()!,
  src: mod.default,
}));
---

{
  render && (
    <>
      <StyleGuideGroup
        title="Phosphor"
        caption="Icons from the Phosphor set, by name: <Icon name>. Any of its icons can be used."
        variant="tiles"
      >
        {phosphor.map((name) => (
          <StyleGuideItem label={name} copy={name} variant="card">
            <span class="style-guide-icons_cell">
              <Icon name={name} variant="large" />
            </span>
          </StyleGuideItem>
        ))}
      </StyleGuideGroup>

      <StyleGuideGroup
        title="Phosphor weights"
        caption="Each icon comes in six weights, to sit with lighter or heavier type."
        variant="tiles"
      >
        {weights.map((weight) => (
          <StyleGuideItem label={`weight="${weight}"`} variant="card">
            <span class="style-guide-icons_cell">
              <Icon name="star" weight={weight} variant="large" />
            </span>
          </StyleGuideItem>
        ))}
      </StyleGuideGroup>

      <StyleGuideGroup
        title="Custom"
        caption="Icons drawn for the site, from assets/icons: <Icon src>."
        variant="tiles"
      >
        {customIcons.map((icon) => (
          <StyleGuideItem label={`assets/icons/${icon.name}`} variant="card">
            <span class="style-guide-icons_cell">
              <Icon src={icon.src} variant="large" />
            </span>
          </StyleGuideItem>
        ))}
      </StyleGuideGroup>
    </>
  )
}

<style is:global>
  @layer components {
    .style-guide-icons_cell {
      display: grid;
      place-items: center;
      align-self: stretch;
      min-height: 5rem;
    }
  }
</style>
