---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Group title. */
  title: string;
  /** One line under the title: what the group shows. */
  caption?: string;
  /** Item layout: a stack, rows divided by rules, small tiles, or wider cards. */
  variant?: "list" | "rows" | "tiles" | "cards";
}

const {
  render = true,
  title,
  caption,
  variant = "list",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && title && content && (
    <div
      class:list={[
        "style-guide-group_wrap",
        variant !== "list" && variant,
        className,
      ]}
      {...rest}
    >
      <div class="style-guide-group_head">
        <h3 class="style-guide-group_title text-style-h5">{title}</h3>
        {caption && (
          <p class="style-guide-group_caption text-style-small">{caption}</p>
        )}
      </div>
      <div class="style-guide-group_list">
        <Fragment set:html={content} />
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .style-guide-group_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      width: 100%;

      .style-guide-group_head {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }
      .style-guide-group_title,
      .style-guide-group_caption {
        margin: 0;
      }
      .style-guide-group_caption {
        max-width: 60ch;
        color: var(--text-2);
      }
      .style-guide-group_list {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
      }

      &.rows .style-guide-group_list {
        gap: 0;
        border-top: var(--border-width) solid var(--border);

        > * {
          padding-block: var(--space-4);
          border-bottom: var(--border-width) solid var(--border);
        }
      }

      &:is(.tiles, .cards) .style-guide-group_list {
        display: grid;
        gap: var(--site-gutter);
      }
      &.tiles .style-guide-group_list {
        grid-template-columns: repeat(auto-fill, minmax(min(11rem, 40%), 1fr));
      }
      /* Cards share the row between them, so a short group has no empty
         column at its end. */
      &.cards .style-guide-group_list {
        grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      }
    }
  }
</style>
