---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Group title. */
  title: string;
  /** Item layout. */
  variant?: "list" | "rows" | "grid" | "scroll";
}

const {
  render = true,
  title,
  variant = "list",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && title && content && (
    <div
      class:list={[
        "style-guide-group_wrap",
        variant !== "list" && variant,
        className,
      ]}
      {...rest}
    >
      <h3 class="style-guide-group_title text-style-h6">{title}</h3>
      <div class="style-guide-group_list">
        <Fragment set:html={content} />
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .style-guide-group_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      width: 100%;

      .style-guide-group_list {
        display: flex;
        flex-direction: column;
        gap: var(--space-7);
      }

      &.rows .style-guide-group_list {
        gap: var(--space-4);
      }

      &.grid .style-guide-group_list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(14rem, 40%), 1fr));
        gap: var(--space-6) var(--site-gutter);
      }

      &.scroll .style-guide-group_list {
        display: grid;
        grid-auto-flow: column;
        grid-template-columns: minmax(15rem, 1fr);
        grid-auto-columns: minmax(16rem, 1fr);
        gap: var(--site-gutter);
        margin-inline: calc(var(--site-margin) * -1);
        padding-inline: var(--site-margin);
        overflow-x: auto;
        scrollbar-color: var(--border) transparent;
      }
    }
  }
</style>
