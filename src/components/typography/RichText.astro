---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";
import type { TextStyle } from "@/styles/generated/tokens.ts";

type RichTextStyle = "inherit" | TextStyle;

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Type style. */
  variant?: RichTextStyle;
  /**
   * Maximum line length in characters.
   *
   * @min 1
   * @int
   */
  maxWidth?: number;
}

const {
  render = true,
  variant = "inherit",
  maxWidth,
  class: className,
  ...rest
} = Astro.props;

// A wide table scrolls sideways inside the text, so it must be reachable by
// keyboard to scroll. Added here, so CMS content needs nothing.
const content = (await slotContent(Astro.slots)).replace(
  /<table(?![^>]*\btabindex=)/g,
  '<table tabindex="0"',
);
---

{
  render && content && (
    <div
      class:list={[
        "text",
        "rich-text",
        variant !== "inherit" && `text-style-${variant}`,
        className,
      ]}
      style={maxWidth ? `--_mw: ${maxWidth}ch;` : undefined}
      {...rest}
    >
      <Fragment set:html={content} />
    </div>
  )
}

<style is:global>
  @layer components {
    .rich-text {
      &
        :is(
          h1,
          h2,
          h3,
          h4,
          h5,
          h6,
          p,
          ul,
          ol,
          blockquote,
          figure,
          pre,
          table,
          hr
        ) {
        margin-top: var(--_margin-top);
        margin-bottom: var(--_margin-bottom);
      }

      & > :first-child,
      & :is(blockquote, li) > :first-child:not(:is(ul, ol)) {
        margin-top: 0;
      }
      & > :last-child,
      & :is(blockquote, li) > :last-child {
        margin-bottom: 0;
      }

      & :is(ul, ol) {
        padding-left: 1.5em;
      }
      & ul {
        list-style-type: disc;
      }
      & ul ul {
        list-style-type: circle;
      }
      & ul ul ul {
        list-style-type: square;
      }
      & ol {
        list-style-type: decimal;
      }
      & li::marker {
        color: var(--text-2);
      }
      & li + li {
        margin-top: var(--space-3);
      }

      & li > :is(ul, ol) {
        margin-block: var(--space-3);
      }

      & blockquote {
        padding-left: var(--space-5);
        border-left: var(--border-width) solid var(--border);
      }

      /* Wide tables scroll sideways instead of widening the page. */
      & table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        overflow-wrap: normal;
        /* Its width must not size the text block around it, or the table
           widens the page instead of scrolling inside it. */
        contain: inline-size;
        border-collapse: collapse;
      }
      & :is(th, td) {
        padding: var(--space-3) var(--space-4);
        border-bottom: var(--border-width) solid var(--border);
        text-align: start;
        vertical-align: top;
      }
      & th {
        font-weight: var(--primary-semibold);
      }
    }
  }
</style>
